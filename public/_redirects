# Sanity Studio — the bare /studio path is served as a static asset
# (out/studio/index.html). Every /studio/* sub-route (/studio/structure,
# /studio/intent/create, /studio/schema, ...) is a client-side Sanity route
# with no static asset; those are served by the Pages Function at
# functions/studio/_middleware.ts (it returns the prerendered shell). We do NOT
# add a `/studio/* /studio/index.html 200` rewrite: Pages rejects rewrites to an
# index.html inside the same prefix as an "infinite loop" and silently drops
# them, which is what caused /studio/structure to 404 on refresh.
/studio /studio/index.html 200

# Canonicalize accidental trailing slash on common static files
/favicon.ico/ /favicon.ico 301
/favicon-32x32.png/ /favicon-32x32.png 301
/apple-touch-icon.png/ /apple-touch-icon.png 301
/logortvfontana.jpg/ /logortvfontana.jpg 301
/cdn-cgi/l/email-protection /kontakt/ 302
/cdn-cgi/l/email-protection/ /kontakt/ 302

# Ensure the /lajme listing page resolves in both URL forms.
/lajme /lajme/index.html 200
/lajme/ /lajme/index.html 200

# Ensure top-level pages resolve in both URL forms.
/live /live/index.html 200
/live/ /live/index.html 200
/kontakt /kontakt/index.html 200
/kontakt/ /kontakt/index.html 200

# Legal / about pages — accept the no-trailing-slash form too.
/cookies /cookies/index.html 200
/privacy /privacy/index.html 200
/terms /terms/index.html 200
/gdpr /gdpr/index.html 200
/disclaimer /disclaimer/index.html 200
/rreth-nesh /rreth-nesh/index.html 200

# Article slugs that don't have a static page are served by the
# /lajme/[slug]/ Pages Function (functions/lajme/[slug]/index.ts), which
# returns the /lajme/_/index.html fallback shell so brand-new Sanity
# articles render via client-side fetch before the next build.

# Fallback to 404 page for unmatched routes
/* /404.html 404
